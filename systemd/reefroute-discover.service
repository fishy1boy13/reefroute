[Unit]
Description=Discover ReefRoute provider catalogs
After=network.target

[Service]
Type=oneshot
User={{USER}}
WorkingDirectory={{INSTALL_DIR}}
EnvironmentFile={{INSTALL_DIR}}/credentials.env
ExecStart={{INSTALL_DIR}}/.venv/bin/reefroute --config {{INSTALL_DIR}}/reefroute.toml discover
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{INSTALL_DIR}}
